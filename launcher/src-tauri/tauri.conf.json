{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orthographic Template Generator",
  "version": "0.1.0",
  "identifier": "com.mdf.ortho",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../app.py": "app.py",
      "../../compositor.py": "compositor.py",
      "../../renderer.py": "renderer.py",
      "../../model_loader.py": "model_loader.py",
      "../../blender_export.py": "blender_export.py",
      "../../depth_render.py": "depth_render.py",
      "../../visibility.py": "visibility.py",
      "../../kn5_reader.py": "kn5_reader.py",
      "../../kn5_to_obj.py": "kn5_to_obj.py",
      "../../_check_python_version.py": "_check_python_version.py",
      "../../requirements.txt": "requirements.txt",
      "../../templates/": "templates/",
      "../../static/": "static/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
